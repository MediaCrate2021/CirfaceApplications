# Server
PORT=3001
APP_ENV=development
SESSION_SECRET=change-me-in-production
LOG_LEVEL=info

# Cirface Asana service account — used to post analysis reports to Cirface's workspace
# The client never sees these credentials
CIRFACE_ASANA_PAT=
CIRFACE_TRACKING_PROJECT_GID=

# CORS (production only)
ALLOWED_ORIGIN=https://estimator.cirface.com

# Asana OAuth — for clients connecting their Asana source
# Register at: https://app.asana.com/0/my-apps
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=
ASANA_REDIRECT_URI=http://localhost:5174/auth/asana/callback

# Monday.com OAuth — for clients connecting their Monday source
# Register at: https://monday.com/apps/manage
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_REDIRECT_URI=http://localhost:5174/auth/monday/callback

# Smartsheet OAuth — requires Smartsheet Developer Program approval before use
# Register at: https://developers.smartsheet.com
SMARTSHEET_CLIENT_ID=
SMARTSHEET_CLIENT_SECRET=
SMARTSHEET_REDIRECT_URI=http://localhost:5174/auth/smartsheet/callback
